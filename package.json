{
  "name": "folio-pdf",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/assets.mjs && vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/assets.mjs && vite build",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/unit/*.test.mjs",
    "test:native": "node scripts/test-native.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "check": "npm run format:check && npm run typecheck && npm test && npm run test:rust && npm run check:rust",
    "package:source": "node scripts/package-source.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "license": "MIT",
  "description": "Leitor de PDF para Windows com biblioteca local e leitura por telas.",
  "engines": {
    "node": ">=24"
  }
}
